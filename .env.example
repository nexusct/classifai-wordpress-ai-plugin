# ==========================================================================
# ClassifAI WordPress AI Plugin - Environment Variables Template
# ==========================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git (it's in .gitignore).
# ==========================================================================

# ---- WordPress Configuration ----
WP_HOME=http://localhost:8080
WP_SITEURL=http://localhost:8080
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_HOST=localhost

# ---- AI/ML Provider API Keys ----
# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google Cloud / Google Maps
GOOGLE_MAPS_API_KEY=AIza-your-google-maps-api-key-here
GOOGLE_CLOUD_PROJECT=your-project-id

# IBM Watson
IBM_WATSON_API_KEY=your-watson-api-key-here
IBM_WATSON_URL=https://api.us-south.natural-language-understanding.watson.cloud.ibm.com

# Azure Cognitive Services
AZURE_API_KEY=your-azure-api-key-here
AZURE_ENDPOINT=https://your-resource.cognitiveservices.azure.com

# AWS (if using AWS services)
AWS_ACCESS_KEY_ID=AKIA-your-access-key-here
AWS_SECRET_ACCESS_KEY=your-secret-access-key-here
AWS_DEFAULT_REGION=us-east-1

# ---- Authentication & Security ----
# WordPress salts (generate at https://api.wordpress.org/secret-key/1.1/salt/)
AUTH_KEY=put-your-unique-phrase-here
SECURE_AUTH_KEY=put-your-unique-phrase-here
LOGGED_IN_KEY=put-your-unique-phrase-here
NONCE_KEY=put-your-unique-phrase-here
AUTH_SALT=put-your-unique-phrase-here
SECURE_AUTH_SALT=put-your-unique-phrase-here
LOGGED_IN_SALT=put-your-unique-phrase-here
NONCE_SALT=put-your-unique-phrase-here

# ---- Development Settings ----
WP_DEBUG=false
WP_DEBUG_LOG=false
WP_DEBUG_DISPLAY=false
SCRIPT_DEBUG=false

# ---- Optional: Third-party Services ----
# Stripe (if used for payments)
STRIPE_PUBLIC_KEY=pk_test_your-stripe-public-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# SendGrid (if used for email)
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here

# ---- Security Notes ----
# 1. NEVER commit this file with real values
# 2. Rotate all API keys if accidentally exposed
# 3. Use different keys for dev/staging/production
# 4. Enable MFA on all API provider accounts
# 5. Monitor API usage for unusual activity
